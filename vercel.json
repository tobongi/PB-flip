{
  "buildCommand": "echo skip-build",
  "outputDirectory": "build",
  "installCommand": "echo skip-install",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!static/|images/|models/|.*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|glb|gltf|json|map|wasm|mp3|mp4|woff|woff2|ttf|otf)).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
