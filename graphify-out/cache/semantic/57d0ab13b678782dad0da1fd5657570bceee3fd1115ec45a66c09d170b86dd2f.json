{"nodes": [{"id": "projblend_plan", "label": "Seamless Ortho\u00e2\u2020\u201dPersp Projection Blend Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-05-01-seamless-projection-blend.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "projblend_matrix_lerp", "label": "Element-wise Projection Matrix Lerp", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-05-01-seamless-projection-blend.md", "source_location": "line 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both OrthographicCamera and PerspectiveCamera stay alive in scene graph. Per-frame, the host camera's projectionMatrix is overridden with an element-wise lerp of the two cameras' native matrices. At blend=0 host gets ortho matrix; at blend=1 host gets persp matrix; in between the user perceives a continuous dolly-zoom-like warp rather than a mode swap. Chosen over instant swap because the prior approach only matched bottle size at swap time, leaving foreshortening as a single-frame snap."}, {"id": "projblend_blend_state", "label": "Projection Blend State (_targetProjectionBlend / _smoothedProjectionBlend)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-05-01-seamless-projection-blend.md", "source_location": "line 95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "_targetProjectionBlend flips instantly when setProjection is called; _smoothedProjectionBlend lerps toward it each frame with PROJECTION_BLEND_DAMPING=1.6 (~95% in 1.9s). activeCamera is selected by smoothed blend \u00e2\u2030\u00a50.5, making the host swap a visual no-op (both cameras render the same blended matrix at the crossover frame)."}, {"id": "projblend_damping_constant", "label": "PROJECTION_BLEND_DAMPING = 1.6", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-05-01-seamless-projection-blend.md", "source_location": "line 83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1.6 gives ~95% convergence in 1.9s \u00e2\u20ac\u201d sweet spot where user no longer perceives two camera modes but also doesn't notice transition starting/ending. Above ~3 reintroduces brutal-feeling snap; below ~1.0 transition drags so long the next flip can interrupt mid-blend."}, {"id": "projblend_apply_projection", "label": "_applyProjectionParams \u00e2\u20ac\u201d Per-Frame Blend Override", "file_type": "document", "source_file": "docs/superpowers/plans/2026-05-01-seamless-projection-blend.md", "source_location": "line 371", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "projblend_test_continuity", "label": "Regression Test \u00e2\u20ac\u201d No Perceptual Snap (15% frame-delta bound)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-05-01-seamless-projection-blend.md", "source_location": "line 538", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asserts that no single update() call changes any projection matrix element by more than 15% of the total endpoint delta. A hard cut would be 100% on one frame; the lerp distributes it over ~30 frames, keeping the per-frame ratio well under 15%."}, {"id": "projblend_set_projection", "label": "setProjection \u00e2\u20ac\u201d Blend Target Setter (not instant swap)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-05-01-seamless-projection-blend.md", "source_location": "line 147", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "projblend_blended_matrix", "label": "_blendedProjMatrix Scratch Matrix4", "file_type": "document", "source_file": "docs/superpowers/plans/2026-05-01-seamless-projection-blend.md", "source_location": "line 348", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source"