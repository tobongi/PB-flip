{"nodes": [{"id": "adaptivezoom_plan", "label": "Adaptive Camera Zoom Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-04-30-adaptive-camera-zoom.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adaptivezoom_compute_zoom", "label": "_computeTargetZoom \u00e2\u20ac\u201d View-Space Extent Fitting", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-30-adaptive-camera-zoom.md", "source_location": "line 152", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projects bottle and landing-zone positions into camera view space via dot product with camera local X/Y axes, adds CAM_ZOOM_PADDING (1.5 world units), then takes the smaller zoom of both axes (more zoomed out) so both fit, clamped to [CAM_ZOOM_MIN, CAM_ZOOM_MAX]. Avoids per-frame allocation by reusing _camRight, _camUp, _zoomOffset vectors."}, {"id": "adaptivezoom_constants", "label": "Zoom Constants (CAM_ZOOM_MIN/MAX/PADDING)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-04-30-adaptive-camera-zoom.md", "source_location": "line 33", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adaptivezoom_ui_compensation", "label": "UI Group Counter-Scale Compensation", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-30-adaptive-camera-zoom.md", "source_location": "line 230", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI group is counter-positioned and counter-scaled (scale = 1/camera.zoom, position = camera frustum edge / zoom) so score text maintains screen-corner position and world size regardless of zoom level."}, {"id": "adaptivezoom_flip_damping", "label": "Dual Zoom Damping (flip vs idle)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-30-adaptive-camera-zoom.md", "source_location": "line 225", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "During flips (500ms) uses _flipDamping=14 (same as camera position damping) so zoom reaches target before bottle reaches arc peak. During idle block-to-block transitions uses gentler _zoomDamping=3 for cinematic feel. Two damping values serve different perceptual goals."}, {"id": "adaptivezoom_ground_plane", "label": "Ground Plane 3x Enlargement for Zoom-Out", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-30-adaptive-camera-zoom.md", "source_location": "line 65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At CAM_ZOOM_MIN=0.55 the visible area grows to 1/0.55\u00e2\u2030\u02c61.82x the frustum. The original 1.2x ground multiplier would leave void at edges. Enlarged to 3x to cover any zoom level with margin."}], "edges": [{"source": "adaptivezoom_plan", "target": "phase3doc_cameracontroller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-04-30-adaptive-camera-zoom.md", "source_location": "line 93", "weight": 1.0}, {"source": "adaptivezoom_plan", "target": "adaptivezoom_compute_zoom", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-04-30-adaptive-camera-zoom.md", "source_location": "line 152", "weight": 1.0}, {"source": "adaptivezoom_plan", "target": "adaptivezoom_constants", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-04-30-adaptive-camera-zoom.md", "source_location": "line 33", "weight": 1.0}, {"source": "adaptivezoom_plan", "target": "adaptivezoom_ui_compensation", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-04-30-adaptive-camera-zoom.md", "source_location": "line 230", "weight": 1.0}, {"source